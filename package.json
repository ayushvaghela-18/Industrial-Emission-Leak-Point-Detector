{
  "name": "ecoforge-ai",
  "version": "1.0.0",
  "description": "EcoForge AI - Industrial Emission Leak Point Detector and Optimization Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "install:all": "npm install",
    "build": "npm run build --workspace=client"
  },
  "keywords": [
    "emissions",
    "sustainability",
    "ai",
    "leak-detector",
    "monorepo"
  ],
  "author": "EcoForge AI Team",
  "license": "MIT",
  "dependencies": {
    "react-router-dom": "^7.18.3"
  }
}
